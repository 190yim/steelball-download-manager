{
  "manifest_version": 3,
  "name": "SteelBall Download Manager",
  "version": "1.2.0",
  "description": "A colorful retro download popup and dashboard for Chrome.",
  "minimum_chrome_version": "96",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["downloads"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open SteelBall download popup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  }
}
